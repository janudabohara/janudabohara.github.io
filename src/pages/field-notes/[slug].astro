---
import { getCollection } from 'astro:content';
import ImageMat from '../../components/ImageMat.astro';
import MetadataRow from '../../components/MetadataRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('field-notes', ({ data }) => !data.draft);
  return entries.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---
<BaseLayout title={`${entry.data.title} — Januda Bohara`} description={entry.data.summary} type="article" image={entry.data.coverImage?.src}>
  <article>
    <header class="pt-6 pb-14 border-b border-hairline"><MetadataRow items={['Field Note', entry.data.eventDate?.toLocaleDateString('en',{year:'numeric',month:'long',day:'numeric'}), entry.data.location, entry.data.role]} /><h1 class="mt-7 font-serif text-6xl md:text-8xl leading-[.9]">{entry.data.title}</h1><p class="mt-10 max-w-3xl text-xl leading-relaxed text-ink-secondary">{entry.data.summary}</p></header>
    {entry.data.coverImage && entry.data.altText && <div class="my-12"><ImageMat src={entry.data.coverImage.src} alt={entry.data.altText} caption={entry.data.captions[0]} folio="FIELD IMAGE" /></div>}
    <div class="article-copy glass-panel rounded-[32px] p-7 md:p-12 max-w-4xl mx-auto my-12"><Content /></div>
    {entry.data.gallery.length > 0 && <section aria-label="Gallery" class="grid md:grid-cols-2 gap-6 my-12">{entry.data.gallery.map((image,index) => <ImageMat src={image.src} alt={entry.data.captions[index] ?? `${entry.data.title}, image ${index + 1}`} caption={entry.data.captions[index]} folio={`FIG. ${String(index + 1).padStart(2,'0')}`} />)}</section>}
  </article>
</BaseLayout>
