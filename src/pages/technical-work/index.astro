---
import { getCollection } from 'astro:content';
import ArchivePage from '../../components/ArchivePage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('technical-work', ({ data }) => !data.draft)).sort((a,b) => (a.data.displayOrder ?? 999) - (b.data.displayOrder ?? 999) || b.data.date.valueOf() - a.data.date.valueOf());
const items = entries.map((entry, index) => ({ slug: entry.slug, title: entry.data.title, summary: entry.data.summary, tags: entry.data.tags, folio: `TW-${String(index + 1).padStart(3,'0')}`, url: `/technical-work/${entry.slug}`, date: entry.data.date.getFullYear().toString() }));
---
<BaseLayout title="Technical Work — Januda Bohara"><ArchivePage folio="01" title="Technical Work" description="Engineering, software, robotics, AI, and research—organized by capability and supported by evidence." items={items} label="Work" /></BaseLayout>
